# Copie para .env e ajuste (nunca commite o .env)
# APP_ENV: development | homolog | production

APP_ENV=development
NODE_ENV=development

# Servidor Node
PORT=8080
HOST=0.0.0.0

# PostgreSQL
DB_HOST=localhost
DB_PORT=15432
DB_USER=admin
DB_PASSWORD=123
DB_NAME=financas

# E-mail (Gmail SMTP)
GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASS=sua-senha-de-app

# --- VM Univates (177.44.248.113) — mesma VM, portas diferentes ---
